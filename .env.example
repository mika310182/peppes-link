# Variables de entorno requeridas en Vercel Dashboard
# (NO subir valores reales al repo)

# Mercado Pago Access Token (producción)
MP_ACCESS_TOKEN=

# Firebase Admin SDK — Service Account JSON
# Generar desde: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Pegar el JSON completo en una línea (minified) en Vercel Dashboard
FIREBASE_SERVICE_ACCOUNT=

# Web Push VAPID keys (para push notifications)
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pedidos@peppes.cl
